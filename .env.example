# Pilih provider: 9router atau openrouter
PROVIDER=9router

# URL endpoint AI Gateway (Opsional, otomatis di-handle config.py)
# API_URL=http://localhost:20128/v1/chat/completions

# Masukkan API Key Anda di sini (atau di OPENROUTER_API_KEY)
API_KEY=sk-or-v1-your-key-here

# Model default
MODEL=anthropic/claude-3.5-sonnet
